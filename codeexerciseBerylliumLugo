def greet_students(name, nChar):
    for i in range(nChar):
        print(name[0: nChar])

name = input("Enter a Name : ")
greet_students(name, len(name))

# a. The syntex error in the code is that the program will print the name n-times with n eing the length of the name. To fix this, I added a - i to be able to remove those characters to form an inverted triangle.
# b. Below is the fixed code.

# Code 2 : Fixed
def greet_students(name, nChar):
    for i in range(nChar):
        print(name[0: (nChar - i)])

name = input("Enter a Name : ")
greet_students(name, len(name))

